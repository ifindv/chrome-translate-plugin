{
  "manifest_version": 3,
  "name": "QuickTranslate",
  "version": "1.0.0",
  "description": "智能翻译助手 - 支持中英划词翻译、语音朗读",
  "author": "ifindv",
  "icons": {
    "16": "assets/icons/icon16.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "tts",
    "scripting"
  ],

  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    },
    "default_title": "QuickTranslate - 智能翻译助手"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": false
  },
  "commands": {
    "translate-selection": {
      "suggested_key": {
        "default": "Ctrl+Shift+T",
        "mac": "Command+Shift+T"
      },
      "description": "翻译当前选中文本"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["assets/icons/*", "ecdict/ecdict.mini.csv"],
      "matches": ["<all_urls>"]
    }
  ]
}
