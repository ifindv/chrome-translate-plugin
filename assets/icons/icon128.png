<!-- SVG Icon placeholder - convert to PNG for production -->
<svg xmlns="http://www.w3.org/2000/svg" width="128" height="128" viewBox="0 0 128 128">
  <!-- Background circle -->
  <circle cx="64" cy="64" r="60" fill="#4A90E2"/>

  <!-- Translation icon - two speech bubbles with arrows -->
  <!-- Left bubble (Chinese) -->
  <rect x="20" y="30" width="40" height="35" rx="6" fill="white" opacity="0.9"/>
  <text x="40" y="52" font-family="Arial" font-size="16" fill="#333" text-anchor="middle">文</text>

  <!-- Arrow -->
  <path d="M65 45 L75 45 L70 40 M75 45 L70 50" stroke="white" stroke-width="3" fill="none"/>

  <!-- Right bubble (English) -->
  <rect x="75" y="55" width="35" height="30" rx="6" fill="white" opacity="0.9"/>
  <text x="92" y="75" font-family="Arial" font-size="12" fill="#333" text-anchor="middle">Aa</text>

  <!-- Speaker icon for TTS -->
  <path d="M30 85 L40 85 L45 90 L45 105 L40 110 L30 110 Z" fill="white"/>
  <path d="M50 95 Q60 95 60 100 Q60 105 50 105" stroke="white" stroke-width="2" fill="none"/>

  <!-- Stars/Dots for decoration -->
  <circle cx="100" cy="25" r="3" fill="white" opacity="0.6"/>
  <circle cx="110" cy="35" r="2" fill="white" opacity="0.6"/>
  <circle cx="95" cy="40" r="2" fill="white" opacity="0.6"/>
</svg>
